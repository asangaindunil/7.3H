# Copy this file to .env and fill in your local values.
# In CI, Jenkins injects these via Credential Manager — do NOT commit .env

# Database (Jenkins credential ID: db-credentials)
DB_USERNAME=postgres
DB_PASSWORD=changeme

# JWT signing key — min 32 chars (Jenkins credential ID: jwt-secret)
JWT_SECRET=replace-with-a-long-random-secret-key-here

# Grafana admin password (Jenkins credential ID: grafana-admin-password)
GRAFANA_ADMIN_PASSWORD=changeme

# Alertmanager SMTP (Jenkins credential ID: alertmanager-smtp)
SMTP_FROM=your-sender@gmail.com
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Alert recipient (Jenkins credential ID: alertmanager-recipient)
ALERT_RECIPIENT=your-team@example.com
